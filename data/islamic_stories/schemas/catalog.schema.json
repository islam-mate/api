{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "islamic_stories/catalog",
  "title": "Islamic Stories Catalog (index.json)",
  "description": "Complete Islamic stories catalog — the single source of truth generated by build_catalog.py",
  "type": "object",
  "required": ["schema_version", "generated_at", "counts", "categories", "channels", "videos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Semver string of this catalog schema",
      "examples": ["1.0.0"]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 date when the catalog was last generated",
      "format": "date",
      "examples": ["2026-10-10"]
    },
    "counts": {
      "type": "object",
      "required": ["channels", "videos"],
      "additionalProperties": false,
      "properties": {
        "channels": { "type": "integer", "minimum": 0 },
        "videos": { "type": "integer", "minimum": 0 }
      }
    },
    "categories": {
      "type": "array",
      "description": "All available categories",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "prophet_stories",
              "seerah",
              "companions",
              "miracles",
              "quran_creatures",
              "islamic_history"
            ]
          },
          "name": {
            "type": "object",
            "required": ["ar", "en"],
            "additionalProperties": false,
            "properties": {
              "ar": { "type": "string" },
              "en": { "type": "string" }
            }
          }
        }
      }
    },
    "channels": {
      "type": "array",
      "description": "All channels — matches channel.schema.json",
      "items": { "$ref": "./channel.schema.json" }
    },
    "videos": {
      "type": "array",
      "description": "All video records — matches video.schema.json",
      "items": { "$ref": "./video.schema.json" }
    }
  }
}